{
  "name": "RNG Application DevContainer",
  "forwardPorts": [3000, 8080, 5432],
  "portsAttributes": {
    "3000": {
      "label": "Frontend UI",
      "onAutoForward": "notify",
      "elevationRequirement": "none"
    },
    "8080": {
      "label": "Backend API",
      "onAutoForward": "notify",
      "elevationRequirement": "none"
    },
    "5432": {
      "label": "PostgreSQL Database",
      "onAutoForward": "ignore"
    }
  },
  "postStartCommand": "sudo service postgresql start || true"
}
