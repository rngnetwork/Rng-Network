# Frontend Environment Variables Template
# Copy this file to .env.local for local frontend development

# Spring Boot Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Discord OAuth2 Authorization Configuration
NEXT_PUBLIC_DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
NEXT_PUBLIC_DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
