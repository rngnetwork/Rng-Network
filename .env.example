# ==============================================================================
# RNG Application Environment Configuration Template
# Copy this file to .env and adjust values for your local or production environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Environment Variables (Next.js)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 2. Backend Server & Port Configuration (Spring Boot)
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 3. Database Credentials (PostgreSQL / Flyway)
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/rng_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 4. Security & JWT Credentials
# ------------------------------------------------------------------------------
# Minimum 256-bit (32+ characters) key for HMAC-SHA256 signing
JWT_SECRET=rngSecretKeyForJwtSigningMustBeAtLeast32BytesLongForHmacSha256!

# ------------------------------------------------------------------------------
# 5. OAuth2 Provider Credentials
# ------------------------------------------------------------------------------
# Google OAuth2 Credentials (Obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Discord OAuth2 Credentials (Obtained from Discord Developer Portal)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# ------------------------------------------------------------------------------
# 6. CORS & Redirect Destinations
# ------------------------------------------------------------------------------
FRONTEND_2FA_URL=http://localhost:3000/auth/2fa
